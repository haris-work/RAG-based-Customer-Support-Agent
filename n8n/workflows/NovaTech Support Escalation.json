    {
      "parameters": {
        "jsCode": "\nconst output = [];\n\nfor (const item of $input.all()) {\n\n  const ticket = item.json.body || {};\n\n  const requiredFields = [\n    \"ticket_id\",\n    \"thread_id\",\n    \"customer_message\",\n    \"intent\",\n    \"status\",\n    \"created_at\"\n  ];\n\n  for (const field of requiredFields) {\n    if (\n      typeof ticket[field] !== \"string\" ||\n      !ticket[field].trim()\n    ) {\n      throw new Error(\n        `Missing or invalid field: ${field}`\n      );\n    }\n  }\n\n  const validIntents = [\n    \"order_account\",\n    \"human_support\"\n  ];\n\n  if (!validIntents.includes(ticket.intent)) {\n    throw new Error(\"Unsupported escalation intent\");\n  }\n\n  if (ticket.status !== \"pending\") {\n    throw new Error(\"Ticket must be pending\");\n  }\n\n  output.push({\n    json: {\n      ticket_id: ticket.ticket_id,\n      thread_id: ticket.thread_id,\n      customer_message: ticket.customer_message,\n      intent: ticket.intent,\n      status: ticket.status,\n      created_at: ticket.created_at\n    }\n  });\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "ae21f37c-4e65-4abb-8624-ef92386d90a5",
